# SaggIA - copia in .env nella root e configura la chiave Gemini Developer API
GOOGLE_API_KEY=la_tua_chiave_gemini

# Directory alternativa per archivio, materiali e copertine SaggIA:
# SAGGIA_DATA_DIR=C:/archivi/saggia

# File .env alternativo, se necessario:
# SAGGIA_ENV_FILE=C:/config/saggia.env
