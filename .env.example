# NarrAI - configurazione locale (copia in .env e compila)
# Unica variabile obbligatoria: chiave Gemini Developer API (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=la_tua_chiave_gemini

# Opzionale: audio TTS (Google Cloud Text-to-Speech, richiede un service account GCP).
# Se assente, i pulsanti audio sono disabilitati ma tutto il resto funziona.
#GOOGLE_APPLICATION_CREDENTIALS=credentials/narrai-app-credentials.json
