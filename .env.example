# NarrAI - configurazione locale (copia in .env e compila)
# Unica variabile obbligatoria: chiave Gemini Developer API (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=la_tua_chiave_gemini

# Archivio saggi (compatibile con SaggIA), separato dall'archivio narrativo:
# SAGGIA_DATA_DIR=C:/archivi/saggia

# Archivio narrativa e fumetti (opzionale):
# NARRAI_DB_PATH=C:/archivi/narrai.sqlite3

# Gemini TTS usa la stessa GOOGLE_API_KEY; nessun service account necessario.
# Suoni dell'interfaccia: locali, facoltativi e configurabili in Impostazioni.
# Proxy Vite se il backend usa una porta diversa da 8000 (nel terminale frontend):
# NARRAI_API_TARGET=http://127.0.0.1:8001
